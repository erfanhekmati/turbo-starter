model User {
  id              String    @id @default(cuid())
  email           String    @unique
  firstName       String
  lastName        String
  passwordHash    String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  totpSecret      String?
  totpEnabledAt   DateTime?
  totpBackupCodes Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens RefreshToken[]
  loginLockout  LoginLockout?
  roles         UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  accounts      OAuthAccount[]
  files         FileObject[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model FileObject {
  id           String   @id @default(cuid())
  key          String   @unique
  bucket       String
  mimeType     String
  size         Int
  originalName String
  publicUrl    String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([uploadedById])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum OtpPurpose {
  REGISTRATION_EMAIL_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

model OtpChallenge {
  id                String     @id @default(uuid())
  email             String
  purpose           OtpPurpose
  codeHash          String
  attempts          Int        @default(0)
  sentCount         Int        @default(1)
  windowStartAt     DateTime   @default(now())
  resendAvailableAt DateTime
  expiresAt         DateTime
  createdAt         DateTime   @default(now())

  @@unique([email, purpose])
}

enum RegistrationStep {
  EMAIL_PENDING_VERIFICATION
  EMAIL_VERIFIED
}

model RegistrationSession {
  id        String           @id @default(uuid())
  email     String           @unique
  step      RegistrationStep @default(EMAIL_PENDING_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum PasswordResetStep {
  PENDING_VERIFICATION
  VERIFIED
}

model PasswordResetSession {
  id        String            @id @default(uuid())
  email     String            @unique
  step      PasswordResetStep @default(PENDING_VERIFICATION)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model LoginLockout {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @updatedAt
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  @@index([userId])
}
