# Copy to `.env` at the repo root for local development.
# Matches credentials from `docker-compose.dev.yml` when using the bundled MySQL service.
DATABASE_URL="mysql://turbo:turbo@localhost:3306/turbo"
REDIS_URL="redis://localhost:6380"

# Bootstrap owner account created by `pnpm db:seed` (ADMIN role)
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me"
SEED_OWNER_FIRST_NAME="Owner"
SEED_OWNER_LAST_NAME="User"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
OTP_HASH_SECRET="replace-with-a-long-random-string"
TOTP_ENCRYPTION_KEY="replace-with-32-char-encryption-key!!"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="USER"
SMTP_PASSWORD="PASSWORD"
SMTP_FROM="no-reply@example.com"
SMTP_SECURE=false

# Comma-separated list of allowed origins for CORS (required when using credentials).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional cookie domain (leave unset for localhost).
# COOKIE_DOMAIN=".example.com"

# Frontend API base URL
NEXT_PUBLIC_API_URL="http://localhost:8000"

# S3-compatible storage (MinIO locally)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="turbo"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio123"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/turbo"

# OAuth (optional — leave unset to disable providers)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=http://localhost:8000
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/dashboard
