# Copy to `.env` at the repo root for local development.
# Matches credentials from `docker-compose.dev.yml` when using the bundled MySQL service.
DATABASE_URL="mysql://turbo:turbo@localhost:3306/turbo"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
OTP_HASH_SECRET="replace-with-a-long-random-string"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="USER"
SMTP_PASSWORD="PASSWORD"
SMTP_FROM="no-reply@example.com"
SMTP_SECURE=false

# Comma-separated list of allowed origins for CORS. Leave unset to allow all origins (dev only).
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
