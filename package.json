{
  "name": "turbo-starter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate:dev": "pnpm --filter @repo/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @repo/database db:migrate:deploy",
    "db:migrate:reset": "pnpm --filter @repo/database db:migrate:reset",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:studio": "pnpm --filter @repo/database db:studio",
    "lint": "turbo run lint",
    "start": "turbo run start"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  }
}
